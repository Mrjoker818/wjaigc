PORT=5000
WUJIE_DATA_DIR=./data
WUJIE_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-a-different-at-least-32-random-characters
PAYMENT_TOKEN_SECRET=replace-with-at-least-32-random-characters
WUJIE_ADMIN_USERNAME=admin
WUJIE_ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Canvas kernel rollout: legacy | shadow | canvas-v2
WUJIE_CANVAS_KERNEL_MODE=legacy
# Agent runtime rollout: legacy | shadow | agent-v2
WUJIE_AGENT_RUNTIME_MODE=legacy
# Workflow renderer rollout: legacy | shadow | react-flow-v2
WUJIE_WORKFLOW_RENDERER_MODE=legacy
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
GEMINI_API_KEY=

# ========== 本地图像工具 ==========
# 是否启用本地 AI 工具 (upscayl / IOPaint)
LOCAL_AI_ENABLED=true

# IOPaint (LaMa) 本地修图服务
IOPAINT_BASE_URL=http://127.0.0.1:8080
IOPAINT_TIMEOUT_MS=300000

# 图片上传限制
IMAGE_MAX_SIZE_MB=20
IMAGE_MAX_EDGE=2048

# 无损放大
UPSCAYL_MODELS_DIR=./upscayl-models
UPSCALE_DEFAULT_SCALE=2
UPSCALE_MAX_SCALE=4
UPSCALE_TIMEOUT_MS=300000
